# Medical Data Toolkit model configuration
# Default src/config.yaml uses GeminiClient for both classification and extraction.
GEMINI_API_KEY=

# LOINC knowledge-base construction helper scripts default to API_KEY.
API_KEY=

# Demo Flask proxy configuration
TOOLKIT_URL=http://localhost:8080
TOOLKIT_TIMEOUT_SECONDS=180
DEMO_PORT=5000

# Informational only. The toolkit reads model provider/name from src/config.yaml,
# not from these demo variables, unless you create a custom config file.
MODEL_PROVIDER=GeminiClient
CLASSIFIER_MODEL_NAME=gemini-3.1-flash-lite-preview
EXTRACTOR_MODEL_NAME=gemini-3-flash-preview

# Alternative LLM configuration in src/config.yaml uses LiteLLMClient.
LITELLM_API_KEY=
